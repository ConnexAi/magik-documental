rules_version = '2';

// El navegador no accede a Firestore: toda lectura y escritura pasa por las
// API Routes con el Admin SDK (lib/firestore.ts), que ignora estas reglas.
// Por eso se niega cualquier acceso directo desde clientes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
